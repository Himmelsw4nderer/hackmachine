#!/usr/bin/env bash
# Hackmachine hack menu: an ASCII app launcher (fzf + figlet + lolcat) in a borderless Konsole.
# Run without arguments it opens its own Konsole window; --tui draws the menu in this terminal.
set -uo pipefail

if [ "${1:-}" != "--tui" ]; then
  # A private konsolerc (no menubar, no toolbars) so this window looks like a bare launcher; the
  # title "hm-menu" is matched by the KWin rule apply.sh installs (no border, centred, on top).
  cfg="${XDG_STATE_HOME:-$HOME/.local/state}/hackmachine/menu-config"
  mkdir -p "$cfg"
  cat > "$cfg/konsolerc" <<'RC'
[Desktop Entry]
DefaultProfile=Hackmachine.profile

[KonsoleWindow]
ShowMenuBarByDefault=false

[MainWindow]
MenuBar=Disabled
StatusBar=Disabled
ToolBarsMovable=Disabled

[MainWindow][Toolbar mainToolBar]
Hidden=true

[MainWindow][Toolbar sessionToolbar]
Hidden=true

[TabBar]
TabBarVisibility=AlwaysHideTabBar
RC
  # Same trick for the toolbars: kxmlgui layouts without any <ToolBar>, plus the real Konsole
  # profiles and colour schemes linked in.
  data="${XDG_STATE_HOME:-$HOME/.local/state}/hackmachine/menu-data"
  mkdir -p "$data/kxmlgui5/konsole"
  ln -sfn "${XDG_DATA_HOME:-$HOME/.local/share}/konsole" "$data/konsole"
  for ui in konsoleui sessionui partui; do
    printf '<!DOCTYPE gui SYSTEM "kpartgui.dtd">\n<gui name="%s" version="999"><MenuBar/></gui>\n' \
      "${ui%ui}" > "$data/kxmlgui5/konsole/$ui.rc"
  done
  HM_REAL_CONFIG="${XDG_CONFIG_HOME:-}" HM_REAL_DATA="${XDG_DATA_HOME:-}" \
    XDG_CONFIG_HOME="$cfg" XDG_DATA_HOME="$data" exec konsole --profile Hackmachine \
    --hide-menubar --hide-tabbar --separate \
    -p 'LocalTabTitleFormat=hm-menu' -p 'RemoteTabTitleFormat=hm-menu' -e "$0" --tui
fi

# Apps launched from here must see the real config dir again.
if [ -n "${HM_REAL_CONFIG+x}" ]; then
  if [ -n "$HM_REAL_CONFIG" ]; then export XDG_CONFIG_HOME="$HM_REAL_CONFIG"; else unset XDG_CONFIG_HOME; fi
  if [ -n "$HM_REAL_DATA" ]; then export XDG_DATA_HOME="$HM_REAL_DATA"; else unset XDG_DATA_HOME; fi
  unset HM_REAL_CONFIG HM_REAL_DATA
fi

banner() {
  if command -v figlet >/dev/null; then
    if command -v lolcat >/dev/null; then figlet -f slant "hackmachine" | lolcat -p 2 -F 0.2
    else printf '\e[38;2;226;181;240m'; figlet -f slant "hackmachine"; printf '\e[0m'; fi
  else
    printf '\n  \e[1;38;2;226;181;240mλ hackmachine\e[0m\n'
  fi
  printf '  \e[38;2;191;174;159mroot@%s · %s · %s\e[0m\n\n' \
    "$(hostname -s 2>/dev/null || cat /etc/hostname)" "$(uname -r)" "$(uptime -p)"
}

list_apps() {
  local d f name
  for d in "${XDG_DATA_HOME:-$HOME/.local/share}/applications" /usr/share/applications \
           /var/lib/flatpak/exports/share/applications "$HOME/.local/share/flatpak/exports/share/applications" \
           /var/lib/snapd/desktop/applications; do
    [ -d "$d" ] || continue
    for f in "$d"/*.desktop; do
      [ -e "$f" ] || continue
      grep -qE '^(NoDisplay|Hidden)=true' "$f" && continue
      grep -q '^Type=Application' "$f" || continue
      name=$(grep -m1 '^Name=' "$f" | cut -d= -f2-)
      [ -n "$name" ] && printf '\e[38;2;196;178;245m[app]\e[0m  %s\t%s\n' "$name" "$f"
    done
  done | sort -u -t$'\t' -k1,1
  printf '\e[38;2;247;165;154m[sys]\e[0m  lock\t@lock\n'
  printf '\e[38;2;247;165;154m[sys]\e[0m  log out\t@logout\n'
  printf '\e[38;2;247;165;154m[sys]\e[0m  reboot\t@reboot\n'
  printf '\e[38;2;247;165;154m[sys]\e[0m  shutdown\t@poweroff\n'
  printf '\e[38;2;166;230;191m[key]\e[0m  show all shortcuts\t@keys\n'
}

clear; banner
if ! command -v fzf >/dev/null; then
  printf '  \e[38;2;247;165;154m[!!]\e[0m fzf is not installed (run ./install.sh)\n'; read -rn1; exit 1
fi

pick=$(list_apps | fzf --ansi --prompt='λ ~/ > ' --delimiter=$'\t' --with-nth=1 \
  --layout=reverse --border=sharp --height=100% --pointer='▶' --info=inline \
  --header='[ ↑↓ navigate · ⏎ launch · esc quit ]' \
  --color='bg:#221d1a,bg+:#372f2a,fg:#f6ece4,fg+:#f6ece4,hl:#f5a8c9,hl+:#f5a8c9,prompt:#a6e6bf,pointer:#c4b2f5,border:#4a3f38,header:#bfae9f,info:#a3cdf5,gutter:#221d1a' \
  | cut -f2) || exit 0

case "$pick" in
  @lock)     loginctl lock-session ;;
  @logout)   qdbus org.kde.LogoutPrompt /LogoutPrompt promptLogout 2>/dev/null || loginctl terminate-session "${XDG_SESSION_ID:-}" ;;
  @reboot)   systemctl reboot ;;
  @poweroff) systemctl poweroff ;;
  @keys)     setsid -f "$(dirname "$0")/hm-keys" --window >/dev/null 2>&1 ;;
  "")        exit 0 ;;
  *)         setsid -f kioclient exec "$pick" >/dev/null 2>&1 \
               || setsid -f gtk-launch "$(basename "$pick" .desktop)" >/dev/null 2>&1 ;;
esac
sleep 0.2
