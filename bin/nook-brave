#!/usr/bin/env bash
# Load the Nook theme into Brave (or any Chromium browser). Chromium only installs
# local themes through its own UI, so this opens the extensions page and says what to click.
# The theme stays installed afterwards; re-run install.sh to update it in place.
theme="${XDG_DATA_HOME:-$HOME/.local/share}/nook/brave-theme"
[ -f "$theme/manifest.json" ] || { echo "theme not found at $theme, run install.sh first"; exit 1; }
printf '\e[38;2;196;178;245mλ Nook theme for Brave\e[0m\n'
printf '  1. turn on \e[1mDeveloper mode\e[0m (top right of the page that just opened)\n'
printf '  2. click \e[1mLoad unpacked\e[0m and choose:\n     \e[38;2;163;205;245m%s\e[0m\n' "$theme"
printf '  (the path is in your clipboard)\n'
printf '%s' "$theme" | wl-copy 2>/dev/null || printf '%s' "$theme" | xclip -selection clipboard 2>/dev/null || true
for b in brave-browser brave com.brave.Browser chromium google-chrome; do
  if command -v "$b" >/dev/null; then setsid -f "$b" "chrome://extensions" >/dev/null 2>&1; exit 0; fi
done
flatpak run com.brave.Browser "chrome://extensions" >/dev/null 2>&1 &
