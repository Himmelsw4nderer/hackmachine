# Hackmachine shell look. Active only inside the Hackmachine Konsole profile (it sets HACKMACHINE=1),
# so other terminals keep their own prompt.
if [[ $- == *i* && -n ${HACKMACHINE:-} ]]; then
  PS1='\[\e[38;2;166;230;191m\]λ\[\e[0m\] \[\e[38;2;163;205;245m\]\w\[\e[0m\] \[\e[38;2;191;174;159m\]>\[\e[0m\] '
  if [[ -z ${HM_FETCHED:-} ]] && command -v fastfetch >/dev/null; then
    export HM_FETCHED=1
    fastfetch
  fi
  alias keys='hm-keys'
fi
