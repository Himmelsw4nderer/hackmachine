# Nook shell look. Active only inside Alacritty or the Nook Konsole profile (both set NOOK=1),
# so other terminals keep their own prompt.
if [[ $- == *i* && -n ${NOOK:-} ]]; then
  PS1='\[\e[38;2;166;230;191m\]λ\[\e[0m\] \[\e[38;2;163;205;245m\]\w\[\e[0m\] \[\e[38;2;191;174;159m\]>\[\e[0m\] '
  if [[ -z ${NOOK_FETCHED:-} ]] && command -v fastfetch >/dev/null; then
    export NOOK_FETCHED=1
    fastfetch
  fi
  alias keys='nook-keys'
  # zoxide, eza, bat, fd, fzf colours
  [ -f "$HOME/.local/share/nook/tools.sh" ] && . "$HOME/.local/share/nook/tools.sh"
fi
