# Hackmachine zsh: oh-my-zsh with the hackmachine theme and pastel highlighting.
# Sourced from the top of ~/.zshrc by a line apply.sh adds; your own settings stay below it.

export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
ZSH_THEME="hackmachine"
DISABLE_AUTO_UPDATE=true          # re-run install.sh to update
COMPLETION_WAITING_DOTS=true
HIST_STAMPS="yyyy-mm-dd"
plugins=(git sudo colored-man-pages zsh-autosuggestions zsh-syntax-highlighting)
command -v fzf >/dev/null && plugins+=(fzf)

# conda: keep "(base)" out of the prompt; the theme shows the env on the right instead
export CONDA_CHANGEPS1=false

ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#7d6d62'
source "$ZSH/oh-my-zsh.sh"

# zsh-syntax-highlighting in the Hackmachine pastels
typeset -gA ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[command]='fg=#a6e6bf'
ZSH_HIGHLIGHT_STYLES[builtin]='fg=#a6e6bf'
ZSH_HIGHLIGHT_STYLES[function]='fg=#a6e6bf'
ZSH_HIGHLIGHT_STYLES[alias]='fg=#94dcd6'
ZSH_HIGHLIGHT_STYLES[precommand]='fg=#e2b5f0,italic'
ZSH_HIGHLIGHT_STYLES[reserved-word]='fg=#f5a8c9'
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=#f7a59a'
ZSH_HIGHLIGHT_STYLES[path]='fg=#a3cdf5,underline'
ZSH_HIGHLIGHT_STYLES[globbing]='fg=#f9c49a'
ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg=#f2e29b'
ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg=#f2e29b'
ZSH_HIGHLIGHT_STYLES[dollar-quoted-argument]='fg=#f2e29b'
ZSH_HIGHLIGHT_STYLES[commandseparator]='fg=#c4b2f5'
ZSH_HIGHLIGHT_STYLES[redirection]='fg=#c4b2f5'
ZSH_HIGHLIGHT_STYLES[single-hyphen-option]='fg=#bfae9f'
ZSH_HIGHLIGHT_STYLES[double-hyphen-option]='fg=#bfae9f'
ZSH_HIGHLIGHT_STYLES[comment]='fg=#7d6d62'

alias keys='hm-keys' menu='hm-menu'
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# fastfetch once per Hackmachine terminal
if [[ -o interactive && -n ${HACKMACHINE:-} && -z ${HM_FETCHED:-} ]] && command -v fastfetch >/dev/null; then
  export HM_FETCHED=1
  fastfetch
fi
